rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email == 'perfectichsan@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function isValidWorkMode(mode) {
      return mode in ['WFO', 'WFH', 'HYBRID'];
    }

    function isValidTimeText(t) {
      return t is string && t.size() == 5 && t.matches('^[0-2][0-9]:[0-5][0-9]$');
    }

    function isValidDateText(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.division is string && data.division.size() >= 1 && data.division.size() <= 60 &&
             data.university is string && data.university.size() <= 100 &&
             data.mentorName is string && data.mentorName.size() <= 80 &&
             data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 80 &&
             isValidWorkMode(data.workModeDefault) &&
             isValidTimeText(data.shiftStart) &&
             isValidTimeText(data.shiftEnd) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAttendanceLog(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.internName is string && data.internName.size() >= 1 && data.internName.size() <= 80 &&
             data.division is string && data.division.size() >= 1 && data.division.size() <= 60 &&
             isValidDateText(data.dateKey) &&
             isValidWorkMode(data.workMode) &&
             data.attendanceStatus in ['ON_TIME', 'LATE'] &&
             data.checkInTime is timestamp && data.checkInTime <= request.time &&
             (!('checkOutTime' in data) || (data.checkOutTime is timestamp && data.checkOutTime <= request.time)) &&
             data.locationLabel is string && data.locationLabel.size() <= 120 &&
             data.dailyActivities is string && data.dailyActivities.size() <= 500 &&
             data.sessionState in ['WORKING', 'COMPLETED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLeaveRequest(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.internName is string && data.internName.size() >= 1 && data.internName.size() <= 80 &&
             data.division is string && data.division.size() >= 1 && data.division.size() <= 60 &&
             data.leaveType in ['SAKIT', 'IZIN_KAMPUS', 'PRIBADI'] &&
             isValidDateText(data.startDate) &&
             isValidDateText(data.endDate) &&
             data.reason is string && data.reason.size() >= 5 && data.reason.size() <= 300 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.reviewerNote is string && data.reviewerNote.size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'fullName', 'email', 'division', 'university',
                         'mentorName', 'companyName', 'workModeDefault',
                         'shiftStart', 'shiftEnd', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'fullName', 'email', 'division', 'university',
                         'mentorName', 'companyName', 'workModeDefault',
                         'shiftStart', 'shiftEnd', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'fullName', 'division', 'university', 'mentorName',
                         'companyName', 'workModeDefault', 'shiftStart',
                         'shiftEnd', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /attendance_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(logId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().sessionState == 'WORKING' &&
                       !('checkOutTime' in incoming()) &&
                       incoming().keys().hasAll([
                         'userId', 'internName', 'division', 'dateKey', 'workMode',
                         'attendanceStatus', 'checkInTime', 'locationLabel',
                         'dailyActivities', 'sessionState', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'internName', 'division', 'dateKey', 'workMode',
                         'attendanceStatus', 'checkInTime', 'checkOutTime', 'locationLabel',
                         'dailyActivities', 'sessionState', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidAttendanceLog(incoming());

      allow update: if isSignedIn() &&
                       isValidId(logId) &&
                       isValidAttendanceLog(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().dateKey == existing().dateKey &&
                       incoming().checkInTime == existing().checkInTime &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           existing().userId == request.auth.uid &&
                           existing().sessionState == 'WORKING' &&
                           incoming().sessionState == 'COMPLETED' &&
                           ('checkOutTime' in incoming()) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'checkOutTime', 'dailyActivities', 'sessionState', 'updatedAt'
                           ])
                         ) ||
                         (
                           existing().userId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'dailyActivities', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isAdmin() && isValidId(logId);
    }

    match /leave_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().reviewerNote == '' &&
                       incoming().keys().hasAll([
                         'userId', 'internName', 'division', 'leaveType',
                         'startDate', 'endDate', 'reason', 'status',
                         'reviewerNote', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'internName', 'division', 'leaveType',
                         'startDate', 'endDate', 'reason', 'status',
                         'reviewerNote', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidLeaveRequest(incoming());

      allow update: if isSignedIn() &&
                       isValidId(requestId) &&
                       isValidLeaveRequest(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           isAdmin() &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'status', 'reviewerNote', 'updatedAt'
                           ])
                         ) ||
                         (
                           existing().userId == request.auth.uid &&
                           existing().status == 'PENDING' &&
                           incoming().status == 'PENDING' &&
                           incoming().reviewerNote == existing().reviewerNote &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'leaveType', 'startDate', 'endDate', 'reason', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isSignedIn() &&
                       isValidId(requestId) &&
                       (
                         (existing().userId == request.auth.uid && existing().status == 'PENDING') ||
                         isAdmin()
                       );
    }
  }
}
